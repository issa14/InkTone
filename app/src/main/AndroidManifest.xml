<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AudioPlaybackService (Tache 5.4) : lecture continue ecran eteint -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- P1 (plan polissage Pareto) : notification media du TTS. Demande a
         l'execution au premier demarrage d'une lecture (pas au lancement de
         l'app) — voir ReaderViewModel.startPlaybackService. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Tache 9.2.2 : trouvee manquante par l'audit de securite -
         VoiceModelDownloader (Tache 5.6/8.7/9.0.1) telecharge le modele
         vocal via java.net.URL.openConnection() ; sans cette permission,
         tout appel reel echoue avec SecurityException des la premiere
         tentative de telechargement sur un device (jamais teste sur
         device jusqu'a cette tache, seulement en unitaire avec des
         fakes). Aucun autre usage reseau dans l'app (offline-first,
         Blueprint §1.4). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".InkToneApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="InkTone"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.InkTone.Starting">

        <!-- K10/ADR-014 : le SDK Crashlytics collecte par defaut des son
             initialisation si on ne le desactive pas explicitement — sans
             cette meta-donnee, une fenetre entre le lancement du process
             et InkToneApplication.onCreate() (qui observe
             UserPreferences.crashReportingEnabled) pourrait collecter
             avant tout consentement. Valeur statique a false ici,
             inconditionnelle : sans effet si google-services.json est
             absent (le plugin/SDK n'est alors pas configure), donc jamais
             a rendre conditionnelle elle-meme. InkToneApplication bascule
             ensuite ce flag au runtime selon le reglage utilisateur reel. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P1 (plan polissage Pareto) : service foreground de la session
             media TTS, pilote le contrat domaine PlaybackSession (plus de
             MediaSessionService Media3 / ExoPlayer fantome). Demarre en
             foreground depuis ReaderViewModel au lancement de la lecture.
             tools:ignore="Instantiatable" : faux positif connu de Lint avec
             Hilt (@AndroidEntryPoint genere une superclasse synthetique). -->
        <service
            android:name="com.inktone.infrastructure.media.AudioPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false"
            tools:ignore="Instantiatable" />

        <!-- Tache 6.2 : desactive l'initialisation par defaut de WorkManager
             (androidx-startup) — InkToneApplication (Configuration.Provider)
             la remplace par une initialisation a la demande avec
             HiltWorkerFactory, seule capable de construire ImportWorker
             (@HiltWorker, dependances injectees). Sans ce retrait, les deux
             initialisations entrent en conflit au demarrage. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Export des statistiques (Lot Statistiques) — FileProvider pour partager
             les fichiers CSV/JSON générés depuis le cacheDir sans FileUriExposedException. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
